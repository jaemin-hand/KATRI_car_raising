{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android: installDebug",
      "type": "shell",
      "command": "./gradlew.bat :app:installDebug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Android: Launch App",
      "type": "shell",
      "command": "adb shell am start -n kr.or.katri.carraising/kr.or.katri.carraising.MainActivity",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Android: Install and Launch",
      "type": "shell",
      "dependsOn": [
        "Android: installDebug",
        "Android: Launch App"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
